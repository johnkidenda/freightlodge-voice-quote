# Optional. The static app works with zero secrets.
# If set while running `npm run dev` / `npm run preview`, the local
# /api/dialog-enhance endpoint can use OpenAI to rewrite the next question.
# Never put a real key in frontend VITE_* vars for GitHub Pages.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cartesia STT A/B — public URL of the token proxy (Worker or local stub).
# The long-lived CARTESIA_API_KEY stays on the proxy only. Never VITE_* it.
# Local Vite also serves /api/stt-token when CARTESIA_API_KEY is set.
# VITE_STT_TOKEN_URL=https://freightlodge-stt-token.example.workers.dev
# VITE_STT_TOKEN_URL=/api/stt-token
VITE_STT_TOKEN_URL=
CARTESIA_API_KEY=

# Production SMTP (Hostinger or other). Used only when you replace the
# email stub in server/vite-plugin-api.js — not required for demo.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=john@freightlodge.com
SMTP_PASS=
MAIL_FROM=john@freightlodge.com
