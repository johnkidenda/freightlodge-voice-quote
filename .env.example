# Optional. The static app works with zero secrets.
# If set while running `npm run dev` / `npm run preview`, the local
# /api/dialog-enhance endpoint can use OpenAI to rewrite the next question.
# Never put a real key in frontend VITE_* vars for GitHub Pages.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public base URL of the Jev + email Worker (or local Vite /api).
# TYPESAFE_API_KEY and RESEND_API_KEY stay on the Worker / stub only. Never VITE_* them.
# Production Worker:
# VITE_API_BASE_URL=https://freightlodge-stt-token.johnkidenda.workers.dev
# Local Vite middleware:
# VITE_API_BASE_URL=/api
# Local Node stub:
# VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_API_BASE_URL=

# Gemini 3.8 Flash TTS. Worker / stub / Vite server only. Never VITE_* this.
# POST {VITE_API_BASE_URL}/tts  model gemini-3.8-flash-tts  default voice Kore.
# One-line lower-latency swap (do not commit a key):
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_API_KEY=

# TypeSafe System One (Jev). Server / proxy only. Never VITE_* this.
# Local Vite serves POST /api/jev when set. The token-proxy stub/worker
# serves POST /jev at the same VITE_API_BASE_URL origin.
TYPESAFE_API_KEY=

# Optional transcript webhook. If unset, Send transcript POSTs silently
# via FormSubmit AJAX to john@freightlodge.com. Mailto is last-resort only.
# VITE_TRANSCRIPT_WEBHOOK_URL=

# Resend HTTP API. Worker / stub only. Never VITE_* this.
# freightlodge.com must be verified in Resend before mail will send.
RESEND_API_KEY=

# Optional From address. Default: Freight Lodge <john@freightlodge.com>
MAIL_FROM=

# Local/test only: log a 6-digit code server-side and skip sending.
# JSON still never includes the code. Do not enable in production.
# EMAIL_VERIFY_DEV_MODE=1
